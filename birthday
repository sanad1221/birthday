<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>إلى صاحبي وفي عيد ميلاده الـ 18</title>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;600;700;900&display=swap" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Cairo', sans-serif;
        }

        body {
            background-color: #070b19;
            color: #f1f5f9;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            overflow: hidden;
            padding: 20px;
            position: relative;
        }

        /* حاوية القلوب المتحركة في الخلفية */
        .hearts-container {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            overflow: hidden;
            z-index: -1;
            pointer-events: none;
        }

        .heart {
            position: absolute;
            bottom: -50px;
            color: rgba(56, 189, 248, 0.15);
            font-size: 1.5rem;
            animation: floatUp 8s linear infinite;
            user-select: none;
        }

        @keyframes floatUp {
            0% {
                transform: translateY(0) scale(0.8) rotate(0deg);
                opacity: 0;
            }
            20% {
                opacity: 0.8;
            }
            100% {
                transform: translateY(-105vh) scale(1.4) rotate(360deg);
                opacity: 0;
            }
        }

        /* خلفية متوهجة متحركة */
        .glow-bg {
            position: absolute;
            width: 400px;
            height: 400px;
            background: linear-gradient(135deg, rgba(2, 132, 199, 0.15), rgba(14, 165, 233, 0.05));
            filter: blur(80px);
            border-radius: 50%;
            top: 10%;
            left: 50%;
            transform: translateX(-50%);
            z-index: -2;
            animation: pulseGlow 6s ease-in-out infinite alternate;
        }

        @keyframes pulseGlow {
            0% { transform: translateX(-50%) scale(1); opacity: 0.6; }
            100% { transform: translateX(-50%) scale(1.2); opacity: 1; }
        }

        .container {
            max-width: 650px;
            width: 100%;
            max-height: 90vh;
            overflow-y: auto;
            background: rgba(15, 23, 42, 0.75);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.08);
            padding: 45px 35px;
            border-radius: 24px;
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
            text-align: center;
            position: relative;
            z-index: 1;
        }

        /* تخصيص السكرولر عشان يكون شكله هادي */
        .container::-webkit-scrollbar {
            width: 6px;
        }
        .container::-webkit-scrollbar-thumb {
            background: rgba(56, 189, 248, 0.2);
            border-radius: 10px;
        }

        .screen {
            display: none;
            opacity: 0;
            transform: translateY(20px);
            transition: all 0.6s ease-in-out;
        }

        .screen.active {
            display: block;
            opacity: 1;
            transform: translateY(0);
        }

        .top-title {
            font-size: 1.2rem;
            font-weight: 700;
            color: #38bdf8;
            letter-spacing: 2px;
            margin-bottom: 12px;
            text-transform: uppercase;
        }

        h1 {
            font-size: 2.8rem;
            font-weight: 900;
            margin-bottom: 15px;
            background: linear-gradient(135deg, #38bdf8, #818cf8, #38bdf8);
            background-size: 200% auto;
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            animation: textGlow 3s ease-in-out infinite alternate;
        }

        @keyframes textGlow {
            0% {
                background-position: 0% 50%;
                filter: drop-shadow(0 0 10px rgba(56, 189, 248, 0.3));
            }
            100% {
                background-position: 100% 50%;
                filter: drop-shadow(0 0 25px rgba(129, 140, 248, 0.6));
            }
        }

        .intro-desc {
            font-size: 1.05rem;
            color: #94a3b8;
            margin-bottom: 35px;
            line-height: 1.6;
        }

        .subtitle {
            font-size: 0.95rem;
            color: #94a3b8;
            margin-bottom: 25px;
            letter-spacing: 0.5px;
        }

        .age-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: rgba(56, 189, 248, 0.1);
            color: #38bdf8;
            padding: 6px 18px;
            border-radius: 30px;
            font-size: 0.9rem;
            font-weight: 600;
            margin-bottom: 30px;
            border: 1px solid rgba(56, 189, 248, 0.2);
        }

        .message-box {
            font-size: 1.15rem;
            line-height: 1.9;
            color: #cbd5e1;
            margin-bottom: 25px;
            text-align: right;
            background: rgba(30, 41, 59, 0.6);
            padding: 24px;
            border-radius: 16px;
            border-right: 4px solid #38bdf8;
            box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.2);
        }

        .prayer-box {
            background: rgba(129, 140, 248, 0.05);
            border: 1px dashed rgba(129, 140, 248, 0.3);
            padding: 16px;
            border-radius: 14px;
            margin-bottom: 30px;
            font-size: 0.95rem;
            color: #a5b4fc;
            line-height: 1.6;
        }

        .btn {
            background: linear-gradient(135deg, #0284c7, #4f46e5);
            color: white;
            border: none;
            padding: 14px 35px;
            font-size: 1.1rem;
            font-weight: 700;
            border-radius: 35px;
            cursor: pointer;
            transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
            box-shadow: 0 6px 20px rgba(2, 132, 199, 0.35);
        }

        .btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 25px rgba(79, 70, 229, 0.5);
            background: linear-gradient(135deg, #0369a1, #4338ca);
        }

        .btn:active {
            transform: translateY(-1px);
        }

        .hidden-note {
            margin-top: 25px;
            font-size: 1.05rem;
            color: #fca5a5;
            display: none;
            opacity: 0;
            transform: scale(0.95);
            transition: all 0.5s ease;
            background: rgba(244, 63, 94, 0.08);
            padding: 20px;
            border-radius: 14px;
            border: 1px solid rgba(244, 63, 94, 0.2);
            line-height: 1.8;
            text-align: right;
        }

        .hidden-note.show {
            display: block;
            opacity: 1;
            transform: scale(1);
        }

        footer {
            margin-top: 35px;
            font-size: 0.85rem;
            color: #64748b;
            letter-spacing: 0.5px;
        }
    </style>
</head>
<body>

    <!-- حاوية القلوب المتحركة -->
    <div class="hearts-container" id="heartsContainer"></div>

    <div class="glow-bg"></div>

    <div class="container">
        
        <!-- الواجهة الأولى (Intro Screen) -->
        <div id="screen1" class="screen active">
            <div class="top-title">أحلا حوده ✨</div>
            <h1>حبيبي تم 18 سنة</h1>
            <p class="intro-desc">عملت لك الواجهة دي عشان اليوم ده خاص، وفيه كلام لازم يتقال بيني وبينك من القلب.</p>
            <button class="btn" onclick="goToScreen2()">اضغط هنا يا صاحبي</button>
        </div>

        <!-- الواجهة الثانية (Main Screen) -->
        <div id="screen2" class="screen">
            <div class="top-title">أحلا حوده 🤍</div>
            <div class="subtitle">يوم مختلف.. بس أنت دايمًا أقوى</div>
            
            <div class="age-badge">
                <span>🎂</span> 10 / 10 — أعتاب الـ 18 سنة
            </div>

            <div class="message-box">
                عارف إن اليوم ده بالنسبة لك مش يوم عادي، وعارف إن الرقم "18" وراه ذكريات بتوجع وذكرى صاحبك الله يرحمه اللي سايب مكانة كبيرة جواك. أنا مش هقولك ابتسم غصب عنك، بس حبيت أفكّرك إنك بقيت راجل قد المسؤولية، وعارف إنك عديت بأيام صعبة أثبتت معدنك الحقيقي. صاحبك ده كان بيتمنى يشوفك دايماً مكمل وواقف على رجليك، وأنا عمر ما هسيبك لوحدك في أي يوم.
            </div>

            <div class="prayer-box">
                "اللهم ارحم صاحبه الذي ترك أثراً طاهراً، واجعل أيامه القادمة مليئة بالسكينة والرضا، وعوضه عن كل لحظة وجع."
            </div>

            <button class="btn" id="secretBtn" onclick="revealMessage()">اقرأ رسالتي ليك من القلب</button>

            <div id="secretNote" class="hidden-note">
                <strong>رسالة خاصة بيني وبينك:</strong><br>
                مهما الدنيا ضغطت عليك أو حسيت إن الحمل تَقيل، تفتكر دايماً إنك مش لوحدك، وإنك أخويا اللي مالي عليا دنيتي. أنا دايماً في ضهرك، في الحلوة قبل المرة.. كل سنة وأنت جدع وقوي زي ما أنا عارفك. 💪❤️
            </div>
        </div>

        <footer>
            مصنوع بحُب ودعم حقيقي لأجلك.
        </footer>
    </div>

    <script>
        // توليد قلوب متحركة تلقائياً في الخلفية
        function createHeart() {
            const container = document.getElementById('heartsContainer');
            const heart = document.createElement('div');
            heart.classList.add('heart');
            heart.innerHTML = '🤍';
            
            // مواقع وأحجام وسرعات عشوائية للقلوب
            heart.style.left = Math.random() * 100 + 'vw';
            heart.style.animationDuration = (Math.random() * 5 + 5) + 's'; // من 5 لـ 10 ثواني
            heart.style.fontSize = (Math.random() * 1 + 0.8) + 'rem';
            
            container.appendChild(heart);

            // حذف القلب بعد انتهاء الأنيميشن عشان الذاكرة
            setTimeout(() => {
                heart.remove();
            }, 10000);
        }

        // إنشاء قلب كل نصف ثانية
        setInterval(createHeart, 500);

        // الانتقال من الواجهة الأولى للثانية
        function goToScreen2() {
            const screen1 = document.getElementById('screen1');
            const screen2 = document.getElementById('screen2');

            screen1.classList.remove('active');
            setTimeout(() => {
                screen1.style.display = 'none';
                screen2.style.display = 'block';
                setTimeout(() => {
                    screen2.classList.add('active');
                }, 50);
            }, 400);
        }

        // إظهار الرسالة السرية داخل الواجهة الثانية
        function revealMessage() {
            const note = document.getElementById('secretNote');
            const btn = document.getElementById('secretBtn');
            if (!note.classList.contains('show')) {
                note.classList.add('show');
                btn.textContent = "اقفل الرسالة";
            } else {
                note.classList.remove('show');
                btn.textContent = "اقرأ رسالتي ليك من القلب";
            }
        }
    </script>

</body>
</html>
